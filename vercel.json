{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/login", "destination": "/frontend/auth.html" },
    { "source": "/auth", "destination": "/frontend/auth.html" },
    { "source": "/account", "destination": "/frontend/account.html" },
    { "source": "/dashboard", "destination": "/frontend/admin/index.html" },
    { "source": "/admin", "destination": "/frontend/admin/index.html" },
    { "source": "/admin/", "destination": "/frontend/admin/index.html" },
    { "source": "/admin/dashboard", "destination": "/frontend/admin/index.html" },
    { "source": "/admin/index", "destination": "/frontend/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/frontend/admin/:path*" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
