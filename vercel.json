{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/frontend/admin/index.html" },
    { "source": "/admin/", "destination": "/frontend/admin/index.html" },
    { "source": "/admin/index.html", "destination": "/frontend/admin/index.html" },
    { "source": "/admin/:match*", "destination": "/frontend/admin/:match*" },
    { "source": "/auth", "destination": "/frontend/auth.html" },
    { "source": "/auth.html", "destination": "/frontend/auth.html" },
    { "source": "/login", "destination": "/frontend/auth.html" },
    { "source": "/account", "destination": "/frontend/account.html" },
    { "source": "/account.html", "destination": "/frontend/account.html" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/:path*", "destination": "/frontend/:path*" }
  ]
}
