# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL URL for production, or zero-config SQLite)
DATABASE_URL=

# Razorpay Payment Gateway (Test keys: rzp_test_..., Live keys: rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Notifications & Alerts
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_gmail_app_password
ATELIER_OWNER_EMAIL=your_owner_email@gmail.com
ATELIER_OWNER_WHATSAPP=917300212948
FAST2SMS_API_KEY=your_fast2sms_api_key

# OAuth Google Login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

